{
  "manifest_version": 3,
  "name": "TalentPulse - LinkedIn Applicants & CV Downloader",
  "version": "1.0.0",
  "description": "Exporta candidatos de postulaciones de empleo en LinkedIn a CSV/JSON y descarga currículums en PDF de forma 100% local.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TalentPulse",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://extensionpay.com/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["background/ExtPay.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.linkedin.com/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["background/ExtPay.js", "popup/ExtPay.js"],
      "matches": ["<all_urls>"]
    }
  ]
}